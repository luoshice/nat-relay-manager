[Unit]
Description=NAT Relay Manager (sing-box TCP-only relay)
Documentation=https://github.com/luoshice/nat-relay-manager
After=network.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
# Deliberately omit User= and Group=: use systemd's default user (root),
# following singbox-lite. This avoids a failing setuid transition in Podman.
# Keep configuration private to root with 0700/0600 file permissions.
UMask=0077
Environment=GOMEMLIMIT=40MiB
Environment=GOGC=50
Environment=GOMAXPROCS=1
ExecStart=/usr/local/bin/sing-box run -c /etc/nrm/config.json
Restart=on-failure
RestartSec=3s
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
