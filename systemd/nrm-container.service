[Unit]
Description=NAT Relay Manager (sing-box TCP-only relay, Podman-compatible)
Documentation=https://github.com/luoshice/nat-relay-manager
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Container namespace root, not host root. Drop all Linux capabilities.
User=root
Group=root
UMask=0077
Environment=GOMEMLIMIT=40MiB
Environment=GOGC=50
Environment=GOMAXPROCS=1
ExecStart=/usr/local/bin/sing-box run -c /etc/nrm/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
